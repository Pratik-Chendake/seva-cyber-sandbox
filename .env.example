# =============================================================================
# Seva Cyber Sandbox — Production & Staging Environment Configuration Template
# Copy this file to .env and fill in your actual credentials when deploying.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENVIRONMENT & OPERATIONAL MODE
# -----------------------------------------------------------------------------
# Options: 'development' (default, local workstation) or 'production' (cloud deployment)
SEVA_ENV="development"

# Fail fast at startup if configured database connection cannot be verified
# Set to 'true' in production to prevent starting in a degraded state
SEVA_STRICT_DB_STARTUP="true"

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL & SQLITE)
# -----------------------------------------------------------------------------
# For PostgreSQL (e.g. Supabase, AWS RDS, Neon, or Railway):
# Set DATABASE_URL with a standard PostgreSQL URI (credentials are masked in logs and health endpoints).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_password@db.example.com:5432/postgres?sslmode=require"

# For SQLite (local development and airgapped workstations only):
# If DATABASE_URL is unset or blank, the application automatically uses SQLite.
# SEVA_CASE_DB_PATH="instance/seva_cases.sqlite3"

# -----------------------------------------------------------------------------
# 3. PRIVATE EVIDENCE STORAGE BACKEND (CLOUDFLARE R2 / S3 / LOCAL)
# -----------------------------------------------------------------------------
# Options: 'local' (default, local uploads directory) or 'r2' / 's3' (Cloudflare R2 / AWS S3)
SEVA_STORAGE_BACKEND="local"

# Cloudflare R2 Credentials (required only when SEVA_STORAGE_BACKEND='r2')
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
CLOUDFLARE_R2_BUCKET_NAME="seva-evidence-vault"
# Optional S3-compatible custom endpoint override (defaults to https://<account_id>.r2.cloudflarestorage.com)
# CLOUDFLARE_R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# -----------------------------------------------------------------------------
# 4. SERVER, CORS & AUTHENTICATION SECURITY
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origin URLs for CORS
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-domain.vercel.app"

# Cryptographic secret for signing operator session tokens (minimum 32 characters)
SEVA_JWT_SECRET="generate_a_cryptographically_secure_random_string_min_32_chars"

# Optional one-time provisioning secret for initial administrator account registration
# If left blank, first operator registration is unlocked only when 0 operators exist in DB
# SEVA_FIRST_ADMIN_TOKEN="your_secure_first_admin_provisioning_token"

# -----------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS PLATFORM (CLOUD API) CONFIGURATION
# -----------------------------------------------------------------------------
# Webhook Handshake Verification Token (Custom secret chosen by you)
WHATSAPP_VERIFY_TOKEN="SEVA_SANDBOX_VERIFY_TOKEN_2026"

# Meta App Secret (Found in Meta Developers Console -> App Settings -> Basic)
# Used to verify incoming X-Hub-Signature-256 HMAC headers
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# Meta Graph API Access Token (Permanent System User Token recommended for production)
WHATSAPP_ACCESS_TOKEN="your_meta_graph_api_access_token_here"

# WhatsApp Business Phone Number ID (From Meta Developers Console -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# Meta Graph API Version (e.g., v21.0)
WHATSAPP_API_VERSION="v21.0"

# Mode: 'simulation' (default, safe for local testing) or 'live' (requires valid credentials)
WHATSAPP_MODE="simulation"

# Privacy Salt for Anonymizing Sender Phone Numbers (Random string)
WHATSAPP_SENDER_SALT="MahaSurakshaPrivacySalt2026"

# Threat Intelligence HMAC Secret Key (Required for phone-indicator correlation)
# Must be at least 16 characters with high entropy.
# In PowerShell: $env:SEVA_THREAT_INTEL_KEY = "your_secure_random_key_here"
# If key is lost or rotated: Historical phone indicators will no longer match incoming
# submissions without re-indexing from original verification logs.
# If key is missing or blank: Phone-indicator matching fails closed safely without crashing.
SEVA_THREAT_INTEL_KEY="your_secure_random_threat_intelligence_hmac_secret_here_min_16_chars"

# Feedback Curation HMAC Secret Key (Required for feedback feature deduplication)
# Must be at least 16 characters with high entropy. Strictly isolated from SEVA_THREAT_INTEL_KEY.
# In PowerShell: $env:SEVA_FEEDBACK_HMAC_KEY = "your_secure_random_feedback_key_here"
# If key is missing or blank: Feedback curation fails closed safely.
SEVA_FEEDBACK_HMAC_KEY="your_secure_random_feedback_hmac_secret_here_min_16_chars"
