# =============================================================================
# SEVA CYBER SANDBOX — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your values.
# NEVER COMMIT REAL SECRETS OR THE ACTUAL .env FILE TO VERSION CONTROL!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & HTTP SERVER
# -----------------------------------------------------------------------------
# Operating mode: 'development' (local workstation) or 'production' (cloud deployment)
SEVA_ENV="development"

# Fail fast at startup if configured database connection cannot be verified
# Set to 'false' for local development; set to 'true' in production
SEVA_STRICT_DB_STARTUP="false"

# Local HTTP API Server host and port
HOST="127.0.0.1"
PORT=8000

# Rate limiting override: Set to '1' only during automated stress testing
DISABLE_RATE_LIMITING="0"

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SUPABASE SHARED POOLER - SESSION MODE)
# -----------------------------------------------------------------------------
# Primary database connection URI for Supabase Shared Pooler (Session Mode).
# Format: postgresql://postgres.vqbqvrlyinieakosgalm:<URL_ENCODED_PASSWORD>@aws-0-eu-central-2.pooler.supabase.com:5432/postgres?sslmode=require
# NOTE: URL-encode any special characters in the password (e.g., '@' -> '%40', '#' -> '%23').
# If left blank, the application automatically uses local SQLite (instance/seva_cases.sqlite3).
DATABASE_URL="postgresql://postgres.vqbqvrlyinieakosgalm:<URL_ENCODED_PASSWORD>@aws-0-eu-central-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional SQLite database path override (used when DATABASE_URL is blank)
# SEVA_CASE_DB_PATH="instance/seva_cases.sqlite3"

# -----------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECRETS & PRIVACY HMAC KEYS
# -----------------------------------------------------------------------------
# Threat Intelligence HMAC Secret Key (Required for phone-indicator correlation, min 16 chars)
SEVA_THREAT_INTEL_KEY="generate_a_cryptographically_secure_random_hex_key_min_16_chars"

# Feedback Curation HMAC Secret Key (Required for training feature deduplication, min 16 chars)
SEVA_FEEDBACK_HMAC_KEY="generate_a_cryptographically_secure_random_hex_key_min_16_chars"

# Operator Authentication Session Signing Secret (min 32 chars)
SEVA_JWT_SECRET="generate_a_cryptographically_secure_random_hex_key_min_32_chars"

# -----------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR PROVISIONING
# -----------------------------------------------------------------------------
# One-time secret token unlocking initial administrator registration (/api/auth/setup-admin).
# Required in production or remote environments. Set to a strong secret passphrase.
SEVA_INITIAL_ADMIN_TOKEN=""
SEVA_FIRST_ADMIN_TOKEN=""

# -----------------------------------------------------------------------------
# 5. CORS CONFIGURATION (FRONTEND / BACKEND COMMUNICATION)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin resource sharing
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-domain.vercel.app"

# -----------------------------------------------------------------------------
# 6. PRIVATE EVIDENCE OBJECT STORAGE (CLOUDFLARE R2 / AWS S3)
# -----------------------------------------------------------------------------
# Optional: Cloudflare R2 / S3-compatible cloud object storage credentials.
# If left blank, the application safely stores evidence on the local filesystem (instance/storage/).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="seva-evidence-private"
# R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# -----------------------------------------------------------------------------
# 7. WHATSAPP BUSINESS PLATFORM (CLOUD API / META WEBHOOKS)
# -----------------------------------------------------------------------------
# Mode: 'simulation' (default, safe for local testing) or 'live' (requires valid credentials)
WHATSAPP_MODE="simulation"

# Webhook Handshake Verification Token (Custom secret verified during Meta webhook setup)
WHATSAPP_VERIFY_TOKEN="SEVA_SANDBOX_VERIFY_TOKEN_2026"

# Meta App Secret (Used to verify incoming X-Hub-Signature-256 HMAC headers)
WHATSAPP_APP_SECRET=""

# Meta Graph API Permanent System User Access Token
WHATSAPP_ACCESS_TOKEN=""

# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""

# Meta Graph API Version (e.g., v21.0)
WHATSAPP_API_VERSION="v21.0"

# Privacy Salt for Anonymizing Incoming Sender Phone Numbers
WHATSAPP_SENDER_SALT="MahaSurakshaPrivacySalt2026"

# -----------------------------------------------------------------------------
# 8. EXTERNAL AI & THREAT INTELLIGENCE APIS
# -----------------------------------------------------------------------------
# NOTE: Seva Cyber Sandbox executes 100% locally on CPU using deterministic
# heuristic rule engines and custom shadow MLP neural models (models/).
# Zero external cloud LLM or AI API keys (OpenAI, Gemini, Anthropic) are required!
