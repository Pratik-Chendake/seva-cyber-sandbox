# Seva Cyber Sandbox — WhatsApp Business Platform (Cloud API) Configuration Template
# Copy this file to .env and fill in your actual credentials when deploying.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!

# 1. Webhook Handshake Verification Token (Custom secret chosen by you)
WHATSAPP_VERIFY_TOKEN="SEVA_SANDBOX_VERIFY_TOKEN_2026"

# 2. Meta App Secret (Found in Meta Developers Console -> App Settings -> Basic)
# Used to verify incoming X-Hub-Signature-256 HMAC headers
WHATSAPP_APP_SECRET="your_meta_app_secret_here"

# 3. Meta Graph API Access Token (Permanent System User Token recommended for production)
WHATSAPP_ACCESS_TOKEN="your_meta_graph_api_access_token_here"

# 4. WhatsApp Business Phone Number ID (From Meta Developers Console -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# 5. Meta Graph API Version (e.g., v21.0)
WHATSAPP_API_VERSION="v21.0"

# 6. Mode: 'simulation' (default, safe for local testing) or 'live' (requires valid credentials)
WHATSAPP_MODE="simulation"

# 7. Privacy Salt for Anonymizing Sender Phone Numbers (Random string)
WHATSAPP_SENDER_SALT="MahaSurakshaPrivacySalt2026"

# 8. Threat Intelligence HMAC Secret Key (Required for phone-indicator correlation)
# Must be at least 16 characters with high entropy.
# In PowerShell: $env:SEVA_THREAT_INTEL_KEY = "your_secure_random_key_here"
# If key is lost or rotated: Historical phone indicators will no longer match incoming
# submissions without re-indexing from original verification logs.
# If key is missing or blank: Phone-indicator matching fails closed safely without crashing.
SEVA_THREAT_INTEL_KEY="your_secure_random_threat_intelligence_hmac_secret_here_min_16_chars"

# 9. Feedback Curation HMAC Secret Key (Required for feedback feature deduplication)
# Must be at least 16 characters with high entropy. Strictly isolated from SEVA_THREAT_INTEL_KEY.
# In PowerShell: $env:SEVA_FEEDBACK_HMAC_KEY = "your_secure_random_feedback_key_here"
# If key is missing or blank: Feedback curation fails closed safely.
SEVA_FEEDBACK_HMAC_KEY="your_secure_random_feedback_hmac_secret_here_min_16_chars"
