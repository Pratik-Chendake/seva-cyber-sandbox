# Seva Cyber Sandbox — Frontend Public Environment Configuration Template
# NOTE: Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put private secrets (database passwords, JWT keys, HMAC secrets, R2 keys) here!

# Public Backend REST API Base URL
# Optional in local development: Vite automatically proxies /api to http://127.0.0.1:8000
# For production (e.g., Vercel frontend calling Render backend):
# VITE_API_URL="https://your-backend-service.onrender.com"
VITE_API_URL=
